package Parser;

import java.util.*;
import java_cup.runtime.*;
import Clases.*;            // Estado, TransicionAFD, TransicionAP, AFD, AP, GestorAutomatas
import Errores.ErrorSintactico;

parser code {:
    // Lista global de errores sintácticos
    public static ArrayList<ErrorSintactico> erroresSintacticos = new ArrayList<>();

    // (Opcional) variables capturadas por el lexer — las dejamos por compatibilidad
    private String nombreCapturado;
    private String cadenaCapturada;

    public void capturarNombre(String nombre) { this.nombreCapturado = nombre; }
    public void capturarCadena(String cadena) { this.cadenaCapturada = cadena; }
    public String getNombreCapturado() { return nombreCapturado; }
    public String getCadenaCapturada() { return cadenaCapturada; }

    // Tabla de sincronización para el modo pánico
    private static final Set<Integer> syncSet = new HashSet<>(Arrays.asList(
        sym.MENOR,
        sym.VER_AUTOMATAS,
        sym.DESC,
        sym.ID,
        sym.EOF,
        sym.AFD,
        sym.AP,
        sym.TRANSICIONES,
        sym.LLAVE_DER,
        sym.PUNTO_COMA,
        sym.MENOR_DIAGONAL
    ));

    @Override
    public void syntax_error(Symbol cur_token) {
        // Registrar error
        ErrorSintactico error = new ErrorSintactico(
            cur_token.left + 1,
            cur_token.right + 1,
            (cur_token.value != null) ? cur_token.value.toString() : "null",
            "Sintáctico"
        );
        erroresSintacticos.add(error);
        System.err.println("ERROR SINTÁCTICO: " + error);

        // Recuperación de errores - Modo pánico
        try {
            Symbol next;
            do {
                next = getScanner().next_token();
                if (next.sym == sym.EOF) {
                    System.err.println("ERROR: Llegó al final del archivo durante recuperación");
                    return;
                }
            } while (!syncSet.contains(next.sym));
            
            // Usar el método resume_parse para continuar con el siguiente token
            // en lugar de acceder directamente a cur_token
            resume_parse();
            
        } catch (Exception e) {
            System.err.println("Error durante recuperación: " + e.getMessage());
        }
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) {
        // Registrar error irrecuperable
        ErrorSintactico error = new ErrorSintactico(
            cur_token.left + 1,
            cur_token.right + 1,
            (cur_token.value != null) ? cur_token.value.toString() : "null",
            "Irrecuperable"
        );
        erroresSintacticos.add(error);
        System.err.println("ERROR IRRECUPERABLE: " + error);

        // Intentar recuperación incluso en errores irrecuperables
        try {
            Symbol next;
            do {
                next = getScanner().next_token();
                if (next.sym == sym.EOF) {
                    System.err.println("ERROR: Llegó al final del archivo durante recuperación irrecuperable");
                    return;
                }
            } while (!syncSet.contains(next.sym));
            
            // Usar resume_parse para continuar
            resume_parse();
            
        } catch (Exception e) {
            System.err.println("Error durante recuperación irrecuperable: " + e.getMessage());
        }
    }

    // Método auxiliar para obtener el scanner
    private java_cup.runtime.Scanner getScanner() {
        return this.getScanner();
    }

    // Método para manejar la recuperación y continuar el parsing
    private void resume_parse() {
        // El parser automáticamente continuará con el siguiente token
        // después de que este método termine
    }
:};

/* ===== Terminales ===== */
terminal String MENOR, MAYOR, MENOR_DIAGONAL;
terminal String AFD, AP, NOMBRE, TRANSICIONES;
terminal String VER_AUTOMATAS, DESC;
terminal String IGUAL, LLAVE_IZQ, LLAVE_DER, PAREN_IZQ, PAREN_DER;
terminal String COMA, PUNTO_COMA, DOS_PUNTOS, FLECHA, OR;
terminal String ID, NUMERO, CADENA;
terminal String LAMBDA, STACKTOP;

/* ===== No terminales ===== */
non terminal Object programa;
non terminal Object contenido;
non terminal Object elemento;
non terminal Object automata;
non terminal Object afd;
non terminal Object ap;
non terminal List<String> estados;
non terminal List<String> alfabeto;
non terminal List<String> alfabeto_pila;
non terminal String estado;
non terminal String estado_inicial;
non terminal List<String> estados_aceptacion;
non terminal List transiciones;
non terminal List transiciones_afd;
non terminal List transiciones_ap;
non terminal List transicion_afd;
non terminal List transicion_ap;
non terminal List opciones_afd;
non terminal List opciones_ap;
non terminal Object opcion_afd;
non terminal Object opcion_ap;
non terminal Object comando;
non terminal String simbolo;

/* ===== Precedencias ===== */
precedence left OR;
precedence left FLECHA;
precedence left COMA;
precedence left PUNTO_COMA;

/* ===== Gramática ===== */
start with programa;

programa ::= contenido;

contenido ::=
      /* vacío */
    | contenido elemento
    ;

elemento ::=
      automata
    | comando
    ;

automata ::=
      afd
    | ap
    ;

/* ===== AFD ===== */
afd ::=
    MENOR AFD NOMBRE IGUAL CADENA:nombreCadena MAYOR
        ID IGUAL LLAVE_IZQ estados:est LLAVE_DER PUNTO_COMA
        ID IGUAL LLAVE_IZQ alfabeto:alf LLAVE_DER PUNTO_COMA
        ID IGUAL LLAVE_IZQ estado_inicial:ei LLAVE_DER PUNTO_COMA
        ID IGUAL LLAVE_IZQ estados_aceptacion:eacc LLAVE_DER PUNTO_COMA
        TRANSICIONES DOS_PUNTOS transiciones_afd:trs
        MENOR_DIAGONAL AFD MAYOR
    {: 
        String nombreAutomata = (String)nombreCadena;

        List<Estado> listaEstados = new ArrayList<Estado>();
        for (String n : (List<String>)est) {
            Estado e = new Estado(n);
            if (n != null && n.equals(ei)) e.setInicial(true);
            if (eacc != null && ((List<String>)eacc).contains(n)) e.setAceptacion(true);
            listaEstados.add(e);
        }

        System.out.println("=== Estados AFD ===");
        for (Estado ee : listaEstados) {
            System.out.println("  " + ee);
        }

        System.out.println("=== Alfabeto AFD ===");
        if (alf != null) {
            for (String s : (List<String>)alf) System.out.println("  " + s);
        }

        // Método auxiliar para buscar estados por nombre
        java.util.function.Function<String, Estado> buscarEstado = (nombre) -> {
            for (Estado es : listaEstados) {
                if (es.getNombre().equals(nombre)) {
                    return es;
                }
            }
            System.err.println("ERROR: Estado no encontrado: " + nombre);
            return null;
        };

        // En la sección AFD, el procesamiento se simplifica:
        List<TransicionAFD> listaTransiciones = new ArrayList<TransicionAFD>();
        if (trs != null) {
            for (Object o : (List)trs) {
                if (o instanceof Map) {
                    Map<String, String> transMap = (Map<String, String>)o;
                    String nombreOrigen = transMap.get("origen");
                    String simbolo = transMap.get("simbolo");
                    String nombreDestino = transMap.get("destino");

                    Estado origen = buscarEstado.apply(nombreOrigen);
                    Estado destino = buscarEstado.apply(nombreDestino);

                    if (origen != null && destino != null) {
                        listaTransiciones.add(new TransicionAFD(origen, simbolo, destino));
                    }
                }
            }
        }
        System.out.println("=== Transiciones AFD ===");
        for (TransicionAFD t : listaTransiciones) {
            if (t.getOrigen() != null && t.getDestino() != null) {
                System.out.println("  " + t);
            } else {
                System.err.println("ERROR: Transición inválida - " + t);
            }
        }

        Estado inicial = null;
        List<Estado> aceptacion = new ArrayList<Estado>();
        for (Estado e : listaEstados) {
            if (e.isInicial()) inicial = e;
            if (e.isAceptacion()) aceptacion.add(e);
        }

        AFD nuevo = new AFD(nombreAutomata, listaEstados, (List<String>)alf, inicial, aceptacion, listaTransiciones);
        GestorAutomatas.agregarAutomata(nuevo);
        System.out.println("[OK] AFD agregado: " + nuevo.getNombre());

        RESULT = nuevo;
    :}
    | MENOR AFD NOMBRE IGUAL CADENA:nombreCadena error // Recuperación para AFD mal formado
    {: 
        System.err.println("Error recuperado en definición de AFD");
        RESULT = null;
    :}
;

/* ===== AP ===== */
ap ::=
    MENOR AP NOMBRE IGUAL CADENA:nombreCadena MAYOR
        ID IGUAL LLAVE_IZQ estados:est LLAVE_DER PUNTO_COMA
        ID IGUAL LLAVE_IZQ alfabeto:alf LLAVE_DER PUNTO_COMA
        ID IGUAL LLAVE_IZQ alfabeto_pila:alfp LLAVE_DER PUNTO_COMA
        ID IGUAL LLAVE_IZQ estado_inicial:ei LLAVE_DER PUNTO_COMA
        ID IGUAL LLAVE_IZQ estados_aceptacion:eacc LLAVE_DER PUNTO_COMA
        TRANSICIONES DOS_PUNTOS transiciones_ap:trs
        MENOR_DIAGONAL AP MAYOR
    {: 
        String nombreAutomata = (String)nombreCadena;
        System.out.println("=== INICIANDO PROCESAMIENTO AP ===");
        System.out.println("Nombre del AP: " + nombreAutomata);

        List<Estado> listaEstados = new ArrayList<Estado>();
        for (String n : (List<String>)est) {
            Estado e = new Estado(n);
            if (n != null && n.equals(ei)) e.setInicial(true);
            if (eacc != null && ((List<String>)eacc).contains(n)) e.setAceptacion(true);
            listaEstados.add(e);
        }

        System.out.println("=== Estados AP ===");
        for (Estado ee : listaEstados) {
            System.out.println("  " + ee);
        }

        System.out.println("=== Alfabeto entrada AP ===");
        if (alf != null) {
            for (String s : (List<String>)alf) System.out.println("  " + s);
        }

        System.out.println("=== Alfabeto pila AP ===");
        if (alfp != null) {
            for (String s : (List<String>)alfp) System.out.println("  " + s);
        }

        // Método auxiliar para buscar estados por nombre (para AP)
        java.util.function.Function<String, Estado> buscarEstadoAP = (nombre) -> {
            for (Estado es : listaEstados) {
                if (es.getNombre().equals(nomen)) {
                    return es;
                }
            }
            System.err.println("ERROR: Estado no encontrado: " + nombre);
            return null;
        };

        List<TransicionAP> listaTransiciones = new ArrayList<TransicionAP>();
        System.out.println("=== Procesando Transiciones AP ===");
        System.out.println("Número de transiciones a procesar: " + (trs != null ? ((List)trs).size() : 0));
        
        if (trs != null) {
            for (Object o : (List)trs) {
                System.out.println("Procesando objeto: " + o.getClass().getSimpleName());
                if (o instanceof Map) {
                    Map<String, String> transMap = (Map<String, String>)o;
                    System.out.println("Mapa de transición: " + transMap);
                    
                    String nombreOrigen = transMap.get("origen");
                    String simboloEntrada = transMap.get("simboloEntrada");
                    String simboloExtrae = transMap.get("simboloExtrae");
                    String nombreDestino = transMap.get("destino");
                    String simboloInserta = transMap.get("simboloInserta");
                    
                    System.out.println("Origen: " + nombreOrigen + ", Entrada: " + simboloEntrada + 
                                     ", Extrae: " + simboloExtrae + ", Destino: ..." + nombreDestino + 
                                     ", Inserta: " + simboloInserta);
                    
                    Estado origen = buscarEstadoAP.apply(nombreOrigen);
                    Estado destino = buscarEstadoAP.apply(nombreDestino);
                    
                    if (origen != null && destino != null) {
                        TransicionAP transicion = new TransicionAP(origen, simboloEntrada, simboloExtrae, destino, simboloInserta);
                        listaTransiciones.add(transicion);
                        System.out.println("Transición AP agregada: " + transicion);
                    } else {
                        System.err.println("ERROR: No se pudo crear transición - Origen: " + origen + ", Destino: " + destino);
                    }
                }
            }
        }

        System.out.println("=== Transiciones AP Procesadas ===");
        if (listaTransiciones.isEmpty()) {
            System.out.println("  No se procesaron transiciones AP");
            System.out.println("  trs = " + trs);
        } else {
            for (TransicionAP t : listaTransiciones) {
                if (t.getOrigen() != null && t.getDestino() != null) {
                    System.out.println("  " + t);
                } else {
                    System.err.println("ERROR: Transición inválida - " + t);
                }
            }
        }

        Estado inicial = null;
        List<Estado> aceptacion = new ArrayList<Estado>();
        for (Estado e : listaEstados) {
            if (e.isInicial()) inicial = e;
            if (e.isAceptacion()) aceptacion.add(e);
        }

        AP nuevo = new AP(nombreAutomata, listaEstados, (List<String>)alf, (List<String>)alfp, inicial, aceptacion, listaTransiciones);
        GestorAutomatas.agregarAutomata(nuevo);
        System.out.println("[OK] AP agregado: " + nuevo.getNombre());
        System.out.println("Número de transiciones en AP: " + nuevo.getTransiciones().size());

        RESULT = nuevo;
    :}
    | MENOR AP NOMBRE IGUAL CADENA:nombreCadena error // Recuperación para AP mal formado
    {: 
        System.err.println("Error recuperado en definición de AP");
        RESULT = null;
    :}
;

/* ===== Listas y transiciones ===== */
estados ::=
      estado:e {: 
        List<String> l = new ArrayList<String>();
        l.add((String)e);
        System.out.println("Estado agregado: " + e);
        RESULT = l;
      :}
    | estados:list COMA estado:e {: 
        ((List<String>)list).add((String)e);
        System.out.println("Estado agregado: ..." + e);
        RESULT = list;
      :}
;

estado ::=
      ID:id {: RESULT = id; :}
    | NUMERO:num {: RESULT = num; :}
;

alfabeto ::=
      ID:e {: 
        List<String> l = new ArrayList<String>();
        l.add(e);
        System.out.println("Alfabeto agregado: " + e);
        RESULT = l;
      :}
    | NUMERO:e {: 
        List<String> l = new ArrayList<String>();
        l.add(e);
        System.out.println("Alfabeto agregado: " + e);
        RESULT = l;
      :}
    | alfabeto:list COMA ID:e {: 
        ((List<String>)list).add(e);
        System.out.println("Alfabeto agregado: ..." + e);
        RESULT = list;
      :}
           | alfabeto:list COMA NUMERO:e {: 
        ((List<String>)list).add(e);
        System.out.println("Alfabeto agregado: ..." + e);
        RESULT = list;
      :}
;

alfabeto_pila ::=
      simbolo:e {: 
        List<String> l = new ArrayList<String>();
        l.add(e);
        System.out.println("Símbolo pila agregado: " + e);
        RESULT = l;
      :}
    | alfabeto_pila:list COMA simbolo:e {: 
        ((List<String>)list).add(e);
        System.out.println("Símbolo pila agregado: ..." + e);
        RESULT = list;
      :}
    | error COMA simbolo:e {: 
        // Recuperación: error en lista de alfabeto pila
        System.err.println("Error recuperado en lista de alfabeto pila");
        List<String> l = new ArrayList<String>();
        l.add((String)e);
        RESULT = l;
      :}
    | alfabeto_pila:list error simbolo:e {: 
        // Recuperación: error en continuación de lista
        System.err.println("Error recuperado en continuación de alfabeto pila");
        ((List<String>)list).add((String)e);
        RESULT = list;
      :}
;

simbolo ::=
      ID:id {: RESULT = id; :}
    | LAMBDA:lambda {: RESULT = lambda; :}
    | STACKTOP:stack {: RESULT = stack; :}
    | error {: 
        // Recuperación: error en símbolo
        System.err.println("Error recuperado en símbolo, usando valor por defecto");
        RESULT = "error_symbol";
      :}
;

estado_inicial ::=
    estado:e {: 
        System.out.println("Estado inicial: " + e);
        RESULT = e;
    :}
    | error {: 
        // Recuperación: error en estado inicial
        System.err.println("Error recuperado en estado inicial, usando valor por defecto");
        RESULT = "error_state";
      :}
;

estados_aceptacion ::=
      estado:e {: 
        List<String> l = new ArrayList<String>();
        l.add((String)e);
        System.out.println("Estado de aceptación: " + e);
        RESULT = l;
      :}
    | estados_aceptacion:list COMA estado:e {: 
        ((List<String>)list).add((String)e);
        System.out.println("Estado de aceptación: ..." + e);
        RESULT = list;
      :}
    | error COMA estado:e {: 
        // Recuperación: error en lista de estados de aceptación
        System.err.println("Error recuperado en lista de estados de aceptación");
        List<String> l = new ArrayList<String>();
        l.add((String)e);
        RESULT = l;
      :}
    | estados_aceptacion:list error estado:e {: 
        // Recuperación: error en continuación de lista
        System.err.println("Error recuperado en continuación de estados de aceptación");
        ((List<String>)list).add((String)e);
        RESULT = list;
      :}
;

/* ===== Transiciones AFD ===== */
transiciones_afd ::=
      transicion_afd:t {: 
        RESULT = t;
      :}
    | transiciones_afd:list transicion_afd:t {: 
        ((List)list).addAll((List)t);
        RESULT = list;
      :}
    | error transicion_afd:t {: 
        // Recuperación: error en lista de transiciones AFD
        System.err.println("Error recuperado en lista de transiciones AFD");
        RESULT = t;
      :}
    | transiciones_afd:list error transicion_afd:t {: 
        // Recuperación: error en continuación de lista
        System.err.println("Error recuperado en continuación de transiciones AFD");
        ((List)list).addAll((List)t);
        RESULT = list;
      :}
;

transicion_afd ::=
      estado:origen FLECHA opciones_afd:ops PUNTO_COMA {: 
        List<Map<String, String>> transicionesCompletas = new ArrayList<>();
        
        if (ops instanceof List) {
            for (Object opcion : (List)ops) {
                if (opcion instanceof Map) {
                    Map<String, String> opcionMap = (Map<String, String>)opcion;
                    Map<String, String> transicionCompleta = new HashMap<>();
                    transicionCompleta.put("origen", (String)origen);
                    transicionCompleta.put("simbolo", opcionMap.get("simbolo"));
                    transicionCompleta.put("destino", opcionMap.get("destino"));
                    transicionesCompletas.add(transicionCompleta);
                }
            }
        }
        RESULT = transicionesCompletas;
      :}
    | error FLECHA opciones_afd:ops PUNTO_COMA {: 
        // Recuperación: error en transición AFD (origen incorrecto)
        System.err.println("Error recuperado en transición AFD (origen)");
        RESULT = new ArrayList<Map<String, String>>();
      :}
    | estado:origen error opciones_afd:ops PUNTO_COMA {: 
        // Recuperación: error en transición AFD (falta FLECHA)
        System.err.println("Error recuperado en transición AFD (falta FLECHA)");
        List<Map<String, String>> transicionesCompletas = new ArrayList<>();
        RESULT = transicionesCompletas;
      :}
    | estado:origen FLECHA error PUNTO_COMA {: 
        // Recuperación: error en transición AFD (opciones incorrectas)
        System.err.println("Error recuperado en transición AFD (opciones)");
        RESULT = new ArrayList<Map<String, String>>();
      :}
;

opciones_afd ::=
      opcion_afd:o {: 
        List l = new ArrayList();
        l.add(o);
        RESULT = l;
      :}
    | opciones_afd:list OR opcion_afd:o {: 
        ((List)list).add(o);
        RESULT = list;
      :}
    | error OR opcion_afd:o {: 
        // Recuperación: error en opciones AFD
        System.err.println("Error recuperado en opciones AFD");
        List l = new ArrayList();
        l.add(o);
        RESULT = l;
      :}
    | opciones_afd:list error opcion_afd:o {: 
        // Recuperación: error en continuación de opciones
        System.err.println("Error recuperado en continuación de opciones AFD");
        ((List)list).add(o);
        RESULT = list;
      :}
;

opcion_afd ::=
      ID:s COMA estado:dest {: 
        Map<String, String> transMap = new HashMap<>();
        transMap.put("simbolo", s);
        transMap.put("destino", (String)dest);
        RESULT = transMap;
      :}
    | NUMERO:s COMA estado:dest {: 
        Map<String, String> transMap = new HashMap<>();
        transMap.put("simbolo", s);
        transMap.put("destino", (String)dest);
        RESULT = transMap;
      :}
    | error COMA estado:dest {: 
        // Recuperación: error en opción AFD (símbolo incorrecto)
        System.err.println("Error recuperado en opción AFD (símbolo)");
        Map<String, String> transMap = new HashMap<>();
        transMap.put("simbolo", "error_symbol");
        transMap.put("destino", (String)dest);
        RESULT = transMap;
      :}
    | ID:s error estado:dest {: 
        // Recuperación: error en opción AFD (falta COMA)
        System.err.println("Error recuperado en opción AFD (falta COMA)");
        Map<String, String> transMap = new HashMap<>();
        transMap.put("simbolo", s);
        transMap.put("destino", (String)dest);
        RESULT = transMap;
      :}
;

/* ===== Transiciones AP ===== */
transiciones_ap ::=
      transicion_ap:t {: 
        RESULT = t;
      :}
    | transiciones_ap:list transicion_ap:t {: 
        ((List)list).addAll((List)t);
        RESULT = list;
      :}
    | error transicion_ap:t {: 
        // Recuperación: error en lista de transiciones AP
        System.err.println("Error recuperado en lista de transiciones AP");
        RESULT = t;
      :}
    | transiciones_ap:list error transicion_ap:t {: 
        // Recuperación: error en continuación de lista
        System.err.println("Error recuperado en continuación de transiciones AP");
        ((List)list).addAll((List)t);
        RESULT = list;
      :}
;

transicion_ap ::=
      estado:origen PAREN_IZQ simbolo:symIn PAREN_DER FLECHA PAREN_IZQ simbolo:symPop PAREN_DER COMA estado:dest DOS_PUNTOS PAREN_IZQ simbolo:symPush PAREN_DER PUNTO_COMA {: 
        System.out.println("Procesando transición AP completa - Origen: " + origen + ", Entrada: " + symIn + ", Extrae: " + symPop + ", Destino: " + dest + ", Inserta: " + symPush);
        
        Map<String, String> transicionCompleta = new HashMap<>();
        transicionCompleta.put("origen", (String)origen);
        transicionCompleta.put("simboloEntrada", symIn);
        transicionCompleta.put("simboloExtrae", symPop);
        transicionCompleta.put("destino", (String)dest);
        transicionCompleta.put("simboloInserta", symPush);
        
        List<Map<String, String>> transicionesCompletas = new ArrayList<>();
        transicionesCompletas.add(transicionCompleta);
        
        RESULT = transicionesCompletas;
      :}
    | error PAREN_IZQ simbolo:symIn PAREN_DER FLECHA PAREN_IZQ simbolo:symPop PAREN_DER COMA estado:dest DOS_PUNTOS PAREN_IZQ simbolo:symPush PAREN_DER PUNTO_COMA {: 
        // Recuperación: error en transición AP (origen incorrecto)
        System.err.println("Error recuperado en transición AP (origen)");
        RESULT = new ArrayList<Map<String, String>>();
      :}
    | estado:origen error simbolo:symIn PAREN_DER FLECHA PAREN_IZQ simbolo:symPop PAREN_DER COMA estado:dest DOS_PUNTOS PAREN_IZQ simbolo:symPush PAREN_DER PUNTO_COMA {: 
        // Recuperación: error en transición AP (paréntesis izquierdo entrada)
        System.err.println("Error recuperado en transición AP (paréntesis entrada)");
        RESULT = new ArrayList<Map<String, String>>();
      :}
;

/* ===== Comandos ===== */
comando ::=
      VER_AUTOMATAS PAREN_IZQ PAREN_DER PUNTO_COMA {: 
          System.out.println("[COMANDO] VER_AUTOMATAS ejecutado");
          FuncionesAutomata.verAutomatas();
          RESULT = null;
      :}
    | DESC PAREN_IZQ ID PAREN_DER PUNTO_COMA
      {: 
          java_cup.runtime.Symbol symID = (java_cup.runtime.Symbol)CUP$AnalizadorSintactico$stack.elementAt(CUP$AnalizadorSintactico$top-2);
          String nombre = (String) symID.value;

          System.out.println("[COMANDO] DESC ejecutado sobre: " + nombre);
          FuncionesAutomata.descripcionAutomata(nombre);
          RESULT = null;
      :}
    | ID PAREN_IZQ CADENA PAREN_DER PUNTO_COMA {: 
          java_cup.runtime.Symbol symID = (java_cup.runtime.Symbol) CUP$AnalizadorSintactico$stack.elementAt(CUP$AnalizadorSintactico$top-4);
          java_cup.runtime.Symbol symCad = (java_cup.runtime.Symbol) CUP$AnalizadorSintactico$stack.elementAt(CUP$AnalizadorSintactico$top-2);
          String nombre = (String) symID.value;
          String cadena = (String) symCad.value;

          System.out.println("[COMANDO] VALIDACION ejecutado sobre: " + nombre + " con cadena: " + cadena);
          FuncionesAutomata.validarCadena(nombre, cadena);
          RESULT = null;
      :}
    | error PAREN_IZQ PAREN_DER PUNTO_COMA {: 
        // Recuperación: error en comando VER_AUTOMATAS
        System.err.println("Error recuperado en comando VER_AUTOMATAS");
        RESULT = null;
      :}
    | error PAREN_IZQ ID PAREN_DER PUNTO_COMA {: 
        // Recuperación: error en comando DESC
        System.err.println("Error recuperado en comando DESC");
        RESULT = null;
      :}
    | error PAREN_IZQ CADENA PAREN_DER PUNTO_COMA {: 
        // Recuperación: error en comando de validación
        System.err.println("Error recuperado en comando de validación");
        RESULT = null;
      :}
;